PORT=3000
APP_URL=http://localhost:3000
DATA_DIR=.data
# Set NODE_ENV=production behind an HTTPS reverse proxy for secure cookies.
# AI is unavailable until configured. Keys remain on the server.
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
# Optional password recovery; all SMTP fields are required to enable it.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Full Vercel app: use a dedicated managed PostgreSQL database.
# DATABASE_URL must be set securely on the host. Never commit its value.
DATABASE_URL=
